{
  "name": "react-native-example-app",
  "version": "56.5.1",
  "private": true,
  "scripts": {
    "initProject": "npm install expo && npm install ../../plugin",
    "reinstall": "npm uninstall anyline-ocr-react-native-module && npm install ../../plugin && node add_license_key.js",
    "prebuild": "EXPO_NO_GIT_STATUS=1 npx expo prebuild --clean",
    "start": "npx expo start --dev-client",
    "android": "npx expo run:android --variant release --device",
    "ios": "npx expo run:ios --configuration Release --device",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "anyline-ocr-react-native-module": "file:../../plugin",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "prop-types": "^15.8.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.2",
    "@react-native-community/cli": "latest",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "typescript": "~6.0.3"
  },
  "description": "React Native example app",
  "main": "index.js",
  "license": "MIT",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "anyline-ocr-react-native-module"
        ]
      }
    }
  }
}
